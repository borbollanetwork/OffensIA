# OffensIA environment (copy to .env; .env is git-ignored).
# Nothing here is required to start the MCP server; provider keys are only needed
# if you drive a model through OffensIA directly.

# Base directory (defaults to the repo root)
# OFFENSIA_BASE=/path/to/OffensIA

# Local engine endpoints (bind to localhost by default)
# OFFENSIA_EXECUTION_URL=http://127.0.0.1:8888
# OFFENSIA_RECON_URL=http://127.0.0.1:11235

# Active provider: kimi | glm
# OFFENSIA_PROVIDER=kimi

# Model identifiers are CONFIGURABLE and never invented. Set the exact id from
# your provider console.
# OFFENSIA_MODEL_ID=
# KIMI_MODEL_ID=
# GLM_MODEL_ID=

# Provider API keys (never commit real values)
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
